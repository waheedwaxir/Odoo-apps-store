<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Booking Confirmation Email Template -->
        <record id="email_template_appointment_confirmation" model="mail.template">
            <field name="name">Salon/Spa: Appointment Confirmed</field>
            <field name="model_id" ref="salon_spa_scheduler.model_salon_appointment"/>
            <field name="subject">Your {{ object.env.company.name }} Booking Confirmed: {{ object.name }}</field>
            <field name="email_from">{{ object.env.company.email or user.email_formatted }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <p>Dear <t t-out="object.partner_id.name"/>,</p>
                    <p>Thank you for choosing <t t-out="object.env.company.name"/>! Your appointment booking has been confirmed.</p>
                    <hr style="border: 0; border-top: 1px solid #eeeeee; margin: 15px 0;"/>
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="padding: 5px 0; font-weight: bold; width: 120px;">Appointment ID:</td>
                            <td style="padding: 5px 0;"><t t-out="object.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 0; font-weight: bold;">Branch:</td>
                            <td style="padding: 5px 0;"><t t-out="object.branch_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 0; font-weight: bold;">Room:</td>
                            <td style="padding: 5px 0;"><t t-out="object.room_id.name or 'N/A'"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 0; font-weight: bold;">Service:</td>
                            <td style="padding: 5px 0;"><t t-out="object.service_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 0; font-weight: bold;">Beautician:</td>
                            <td style="padding: 5px 0;"><t t-out="object.staff_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 0; font-weight: bold;">Date &amp; Time:</td>
                            <td style="padding: 5px 0;"><t t-out="object.start_datetime"/></td>
                        </tr>
                    </table>
                    <hr style="border: 0; border-top: 1px solid #eeeeee; margin: 15px 0;"/>
                    <p>If you need to make any changes or cancel, please contact us at <t t-out="object.branch_id.phone or object.env.company.phone or ''"/> or email <t t-out="object.env.company.email or ''"/>.</p>
                    <br/>
                    <p>Best regards,</p>
                    <p><strong><t t-out="object.env.company.name"/> Team</strong></p>
                </div>
            </field>
        </record>

        <!-- 30-Minute Reminder Email Template -->
        <record id="email_template_appointment_reminder_30m" model="mail.template">
            <field name="name">Salon/Spa: Appointment Reminder (30 Mins)</field>
            <field name="model_id" ref="salon_spa_scheduler.model_salon_appointment"/>
            <field name="subject">Reminder: Your {{ object.env.company.name }} Booking starts in 30 minutes!</field>
            <field name="email_from">{{ object.env.company.email or user.email_formatted }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <p>Dear <t t-out="object.partner_id.name"/>,</p>
                    <p>This is a friendly reminder that your booking <strong t-out="object.name"/> at <t t-out="object.env.company.name"/> is scheduled to start in <strong>30 minutes</strong>.</p>
                    <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
                        <tr>
                            <td style="padding: 5px 0; font-weight: bold; width: 120px;">Branch:</td>
                            <td style="padding: 5px 0;"><t t-out="object.branch_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 0; font-weight: bold;">Service:</td>
                            <td style="padding: 5px 0;"><t t-out="object.service_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 0; font-weight: bold;">Beautician:</td>
                            <td style="padding: 5px 0;"><t t-out="object.staff_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 0; font-weight: bold;">Start Time:</td>
                            <td style="padding: 5px 0;"><t t-out="object.start_datetime"/></td>
                        </tr>
                    </table>
                    <p style="margin-top: 15px;">We look forward to seeing you soon!</p>
                    <br/>
                    <p>Best regards,</p>
                    <p><strong><t t-out="object.env.company.name"/> Team</strong></p>
                </div>
            </field>
        </record>

        <!-- Cancellation Limit Reached Warning Email Template -->
        <record id="email_template_cancellation_limit_reached" model="mail.template">
            <field name="name">Salon/Spa: Cancellation Limit Reached</field>
            <field name="model_id" ref="salon_spa_scheduler.model_salon_appointment"/>
            <field name="subject">Booking restriction on {{ object.env.company.name }} due to multiple cancellations</field>
            <field name="email_from">{{ object.env.company.email or user.email_formatted }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <p>Dear <t t-out="object.partner_id.name"/>,</p>
                    <p>We are writing to inform you that you have cancelled <t t-out="ctx.get('cancel_count')"/> appointments with us.</p>
                    <p>According to our company policy, the maximum number of allowed cancellations is <t t-out="ctx.get('limit')"/>.</p>
                    <p style="color: #d9534f; font-weight: bold;">Therefore, future automatic bookings for your account have been temporarily restricted.</p>
                    <p>If you believe this is an error or would like to reactivate booking privileges, please contact our support team at <t t-out="object.env.company.phone or ''"/> or email <t t-out="object.env.company.email or ''"/>.</p>
                    <br/>
                    <p>Best regards,</p>
                    <p><strong><t t-out="object.env.company.name"/> Team</strong></p>
                </div>
            </field>
        </record>
    </data>
</odoo>
