<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salon_review_tree" model="ir.ui.view">
        <field name="name">salon.review.list</field>
        <field name="model">salon.review</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="staff_id"/>
                <field name="rating" widget="priority"/>
                <field name="date"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <record id="view_salon_review_form" model="ir.ui.view">
        <field name="name">salon.review.form</field>
        <field name="model">salon.review</field>
        <field name="arch" type="xml">
            <form string="Customer Review">
                <sheet>
                    <group>
                        <group>
                            <field name="appointment_id"/>
                            <field name="partner_id" readonly="appointment_id"/>
                            <field name="staff_id" readonly="appointment_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="rating" widget="priority"/>
                        </group>
                    </group>
                    <group string="Comment">
                        <field name="comment" placeholder="Write customer comment here..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_salon_review" model="ir.actions.act_window">
        <field name="name">Customer Reviews</field>
        <field name="res_model">salon.review</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
