<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.salon</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Salon &amp; Spa" string="Salon &amp; Spa" name="salon_spa_scheduler">
                    <block title="Scheduler Configuration" name="salon_scheduler_block">
                        <setting string="Working Hours" help="Configure the start and end hours for the scheduler timeline.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="salon_start_hour" class="col-lg-3 o_light_label"/>
                                    <field name="salon_start_hour" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="salon_end_hour" class="col-lg-3 o_light_label"/>
                                    <field name="salon_end_hour" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Cancellation Policy" help="Configure the maximum allowed cancellations for a customer before blocking them.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="salon_max_cancellations" class="col-lg-4 o_light_label"/>
                                    <field name="salon_max_cancellations" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_salon_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'salon_spa_scheduler'}</field>
    </record>
</odoo>
