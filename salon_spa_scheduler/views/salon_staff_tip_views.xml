<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salon_staff_tip_tree" model="ir.ui.view">
        <field name="name">salon.staff.tip.list</field>
        <field name="model">salon.staff.tip</field>
        <field name="arch" type="xml">
            <list string="Staff Tips" create="0" edit="0">
                <field name="date"/>
                <field name="staff_id"/>
                <field name="order_id"/>
                <field name="amount" sum="Total Tips"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-warning="state == 'unpaid'"/>
            </list>
        </field>
    </record>

    <record id="view_salon_staff_tip_form" model="ir.ui.view">
        <field name="name">salon.staff.tip.form</field>
        <field name="model">salon.staff.tip</field>
        <field name="arch" type="xml">
            <form string="Staff Tip" create="0">
                <header>
                    <button name="action_mark_paid" string="Mark as Paid" type="object" class="oe_highlight" invisible="state == 'paid'"/>
                    <button name="action_mark_unpaid" string="Mark as Unpaid" type="object" invisible="state == 'unpaid'"/>
                    <field name="state" widget="statusbar" statusbar_visible="unpaid,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="staff_id" readonly="1"/>
                            <field name="amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="order_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_salon_staff_tip_search" model="ir.ui.view">
        <field name="name">salon.staff.tip.search</field>
        <field name="model">salon.staff.tip</field>
        <field name="arch" type="xml">
            <search string="Search Staff Tips">
                <field name="staff_id"/>
                <field name="order_id"/>
                <filter string="Unpaid" name="unpaid" domain="[('state', '=', 'unpaid')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <group>
                    <filter string="Staff" name="group_by_staff" context="{'group_by': 'staff_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_salon_staff_tip" model="ir.actions.act_window">
        <field name="name">Staff Tips</field>
        <field name="res_model">salon.staff.tip</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_unpaid': 1}</field>
    </record>

</odoo>
