<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salon_commission_tree" model="ir.ui.view">
        <field name="name">salon.commission.list</field>
        <field name="model">salon.commission</field>
        <field name="arch" type="xml">
            <list>
                <field name="staff_id"/>
                <field name="kind"/>
                <field name="appointment_id"/>
                <field name="period" optional="show" widget="date"/>
                <field name="reached" optional="hide"/>
                <field name="rate" optional="hide"/>
                <field name="commission_amount" sum="Total Commissions"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_salon_commission_form" model="ir.ui.view">
        <field name="name">salon.commission.form</field>
        <field name="model">salon.commission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pay" string="Mark Paid" type="object" class="btn-primary" invisible="state == 'paid'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="staff_id" readonly="appointment_id"/>
                            <field name="kind"/>
                            <field name="appointment_id" invisible="kind == 'incentive'"/>
                            <field name="period" invisible="kind != 'incentive'"/>
                            <field name="reached" invisible="kind != 'incentive'"/>
                            <field name="rate" invisible="kind != 'incentive'"/>
                        </group>
                        <group>
                            <field name="commission_amount"/>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_salon_commission_search" model="ir.ui.view">
        <field name="name">salon.commission.search</field>
        <field name="model">salon.commission</field>
        <field name="arch" type="xml">
            <search>
                <field name="staff_id"/>
                <filter string="Monthly Incentives" name="filter_incentive" domain="[('kind', '=', 'incentive')]"/>
                <filter string="Service Commissions" name="filter_service" domain="[('kind', '=', 'service')]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Paid" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <group>
                    <filter string="Beautician" name="groupby_staff" context="{'group_by': 'staff_id'}"/>
                    <filter string="Type" name="groupby_kind" context="{'group_by': 'kind'}"/>
                    <filter string="Month" name="groupby_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_salon_commission" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">salon.commission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
