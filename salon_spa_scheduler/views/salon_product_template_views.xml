<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Product Template Form View -->
    <record id="product_template_form_view_salon" model="ir.ui.view">
        <field name="name">product.template.form.inherit.salon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="is_a_salon"/>
                    <label for="is_a_salon"/>
                </span>
            </xpath>
        </field>
    </record>

    <!-- Inherit Product Template Search View -->
    <record id="product_template_search_view_salon" model="ir.ui.view">
        <field name="name">product.template.search.inherit.salon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <filter string="Is a Salon Product" name="filter_is_a_salon" domain="[('is_a_salon', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Product Template List View -->
    <record id="product_template_tree_view_salon" model="ir.ui.view">
        <field name="name">product.template.list.inherit.salon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_a_salon" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
