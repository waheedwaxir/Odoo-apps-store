<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_salon" model="ir.ui.view">
        <field name="name">res.partner.form.salon</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Salon Info">
                    <separator string="Service History"/>
                    <field name="customer_history_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="service_name"/>
                            <field name="staff_name"/>
                            <field name="state"/>
                            <field name="notes"/>
                            <field name="price_unit" sum="Total Spent"/>
                            <field name="origin"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
