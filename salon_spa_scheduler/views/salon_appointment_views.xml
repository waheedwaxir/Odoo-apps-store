<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salon_appointment_tree" model="ir.ui.view">
        <field name="name">salon.appointment.list</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="branch_id"/>
                <field name="room_id"/>
                <field name="staff_id"/>
                <field name="service_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state"/>
                <field name="payment_state"/>
            </list>
        </field>
    </record>

    <record id="view_salon_appointment_kanban" model="ir.ui.view">
        <field name="name">salon.appointment.kanban</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="staff_id"/>
                <field name="service_id"/>
                <field name="start_datetime"/>
                <field name="state"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    Customer: <field name="partner_id"/>
                                </div>
                                <div>
                                    Beautician: <field name="staff_id"/>
                                </div>
                                <div>
                                    Service: <field name="service_id"/>
                                </div>
                                <div>
                                    Time: <field name="start_datetime"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_salon_appointment_calendar" model="ir.ui.view">
        <field name="name">salon.appointment.calendar</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="start_datetime" date_stop="end_datetime" color="staff_id">
                <field name="partner_id"/>
                <field name="service_id"/>
                <field name="staff_id"/>
            </calendar>
        </field>
    </record>

<record id="view_salon_appointment_search" model="ir.ui.view">
    <field name="name">salon.appointment.search</field>
    <field name="model">salon.appointment</field>
    <field name="arch" type="xml">
        <search string="Salon Appointments">
            <field name="name"/>
            <field name="partner_id"/>
            <field name="phone"/>
            <field name="staff_id"/>
            <field name="branch_id"/>

            <filter string="Walk-in Queue"
                    name="walkin"
                    domain="[('is_walkin', '=', True)]"/>

            <separator/>

            <filter string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"/>

            <filter string="Confirmed"
                    name="confirmed"
                    domain="[('state', '=', 'confirmed')]"/>

            <filter string="In Progress"
                    name="progress"
                    domain="[('state', '=', 'progress')]"/>

            <filter string="Done"
                    name="done"
                    domain="[('state', '=', 'done')]"/>

            <filter string="Cancelled"
                    name="cancel"
                    domain="[('state', '=', 'cancel')]"/>

            <group>
                <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
                <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                <filter string="Beautician" name="group_by_staff" context="{'group_by': 'staff_id'}"/>
            </group>
        </search>
    </field>
</record>
    <record id="view_salon_appointment_form" model="ir.ui.view">
        <field name="name">salon.appointment.form</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_pos_order" type="object" string="Send to POS" class="btn-primary" invisible="pos_order_id != False or state != 'progress'" groups="salon_spa_scheduler.group_salon_create_payment"/>
                    <button name="%(salon_spa_scheduler.action_report_salon_appointment_single)d" type="action" string="Print Details" class="btn-secondary" invisible="state == 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_progress" type="object" string="Start Service" invisible="state != 'confirmed'"/>
                    <button name="action_done" type="object" string="Done" class="btn-primary" invisible="state != 'progress' or payment_state != 'paid'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancel')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="phone" readonly="state != 'draft'"/>
                            <field name="branch_id" readonly="state != 'draft'"/>
                            <field name="room_id" readonly="state != 'draft'"/>
                            <field name="is_walkin" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="staff_service_ids" invisible="1"/>
                            <field name="staff_id" readonly="state != 'draft'"/>
                            <field name="service_ids" widget="many2many_tags" readonly="state != 'draft'" domain="[('id', 'in', staff_service_ids)]"/>
                            <field name="start_datetime" readonly="state != 'draft'"/>
                            <field name="end_datetime" invisible="1"/>
                            <field name="duration_selection" readonly="state != 'draft'"/>
                            <field name="duration" readonly="1"/>
                            <field name="payment_state"/>
                            <field name="pos_order_id"/>
                            <field name="amount_subtotal" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customer History" name="customer_history">
                            <field name="customer_history_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="service_name"/>
                                    <field name="staff_name"/>
                                    <field name="state"/>
                                    <field name="notes"/>
                                    <field name="price_unit"/>
                                    <field name="origin"/>
                                </list>
                            </field>
                        </page>
                        <page string="Service Steps" name="service_steps">
                            <field name="step_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="duration_minutes"/>
                                    <field name="need_staff"/>
                                    <field name="staff_id"/>
                                    <field name="start_datetime" readonly="1"/>
                                    <field name="end_datetime" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Additional Services">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="allowed_service_ids" column_invisible="1"/>
                                    <field name="service_id" domain="[('id', 'in', allowed_service_ids)]"/>
                                    <field name="staff_id"/>
                                    <field name="price_unit" sum="Subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_salon_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">kanban,calendar,list,form</field>
        <field name="search_view_id" ref="view_salon_appointment_search"/>
    </record>
</odoo>
