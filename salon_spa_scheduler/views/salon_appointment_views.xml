<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salon_appointment_tree" model="ir.ui.view">
        <field name="name">salon.appointment.list</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'draft' or (state == 'confirmed' and not confirmation_sent)"
                  decoration-success="state == 'confirmed' and confirmation_sent and not is_arrived"
                  decoration-info="is_arrived and state not in ('done', 'cancel')"
                  decoration-muted="state == 'done'"
                  decoration-danger="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="branch_id" groups="base.group_multi_company" optional="hide"/>
                <field name="room_id"/>
                <field name="staff_required" optional="show"/>
                <field name="staff_ids" widget="many2many_tags"/>
                <field name="staff_id" optional="hide"/>
                <field name="service_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="confirmation_sent" column_invisible="1"/>
                <field name="is_arrived" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft' or (state == 'confirmed' and not confirmation_sent)"
                       decoration-success="state == 'confirmed' and confirmation_sent"
                       decoration-info="state == 'progress'"
                       decoration-muted="state == 'done'"
                       decoration-danger="state == 'cancel'"/>
                <field name="payment_state"/>
            </list>
        </field>
    </record>

    <record id="view_salon_appointment_kanban" model="ir.ui.view">
        <field name="name">salon.appointment.kanban</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="staff_ids"/>
                <field name="service_id"/>
                <field name="start_datetime"/>
                <field name="state"/>
                <field name="payment_state"/>
                <field name="is_arrived"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click o_salon_appt_card color_#{record.color.raw_value}">
                            <div class="o_salon_appt_header">
                                <span class="o_salon_appt_customer" title="Customer">
                                    <field name="partner_id"/>
                                </span>
                                <span class="o_salon_appt_state"><field name="state"/></span>
                            </div>
                            <div class="o_salon_appt_row">
                                <i class="fa fa-scissors o_salon_appt_icon" title="Service" role="img" aria-label="Service"/>
                                <field name="service_id"/>
                            </div>
                            <div class="o_salon_appt_row">
                                <i class="fa fa-user-md o_salon_appt_icon" title="Beauticians" role="img" aria-label="Beauticians"/>
                                <field name="staff_ids" widget="many2many_tags"/>
                            </div>
                            <div class="o_salon_appt_row o_salon_appt_time">
                                <i class="fa fa-clock-o o_salon_appt_icon" title="Start time" role="img" aria-label="Start time"/>
                                <field name="start_datetime"/>
                            </div>
                            <div class="o_salon_appt_footer">
                                <span class="o_salon_appt_ref"><field name="name"/></span>
                                <t t-if="record.payment_state.raw_value == 'paid'">
                                    <span class="o_salon_appt_pill"><i class="fa fa-check"/> Paid</span>
                                </t>
                                <t t-if="record.is_arrived.raw_value">
                                    <span class="o_salon_appt_pill"><i class="fa fa-check-square-o"/> Arrived</span>
                                </t>
                                <button type="object" name="action_rebook"
                                        class="btn btn-sm p-0 o_salon_appt_rebook"
                                        t-if="record.state.raw_value == 'done' || record.state.raw_value == 'cancel'">
                                    <i class="fa fa-repeat" role="img" aria-label="Rebook" title="Rebook"/> Rebook
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_salon_appointment_calendar" model="ir.ui.view">
        <field name="name">salon.appointment.calendar</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="start_datetime" date_stop="end_datetime" color="staff_id" mode="day">
                <field name="partner_id"/>
                <field name="service_id"/>
                <field name="staff_id"/>
            </calendar>
        </field>
    </record>

<record id="view_salon_appointment_search" model="ir.ui.view">
    <field name="name">salon.appointment.search</field>
    <field name="model">salon.appointment</field>
    <field name="arch" type="xml">
        <search string="Salon Appointments">
            <field name="name"/>
            <field name="partner_id"/>
            <field name="phone"/>
            <field name="staff_ids" string="Beautician"/>
            <field name="branch_id" groups="base.group_multi_company"/>

            <filter string="Today"
                    name="filter_today"
                    domain="[('start_datetime', '&gt;=', 'today'),
                             ('start_datetime', '&lt;', 'today +1d')]"/>

            <filter string="Tomorrow"
                    name="filter_tomorrow"
                    domain="[('start_datetime', '&gt;=', 'today +1d'),
                             ('start_datetime', '&lt;', 'today +2d')]"/>

            <filter string="This Week"
                    name="filter_this_week"
                    domain="[('start_datetime', '&gt;=', '=week_start'),
                             ('start_datetime', '&lt;', '=week_start +1w')]"/>

            <separator/>

            <filter string="Walk-in Queue"
                    name="walkin"
                    domain="[('is_walkin', '=', True)]"/>

            <filter string="Beautician Required"
                    name="staff_required"
                    domain="[('staff_required', '=', True)]"/>

            <separator/>

            <filter string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"/>

            <filter string="Confirmed"
                    name="confirmed"
                    domain="[('state', '=', 'confirmed')]"/>

            <filter string="In Progress"
                    name="progress"
                    domain="[('state', '=', 'progress')]"/>

            <filter string="Done"
                    name="done"
                    domain="[('state', '=', 'done')]"/>

            <filter string="Cancelled"
                    name="cancel"
                    domain="[('state', '=', 'cancel')]"/>

            <group>
                <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}" groups="base.group_multi_company"/>
                <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                <filter string="Beautician" name="group_by_staff" context="{'group_by': 'staff_id'}"/>
                <filter string="Start Date" name="group_by_start_date" context="{'group_by': 'start_datetime:day'}"/>
            </group>
        </search>
    </field>
</record>
    <record id="view_salon_appointment_form" model="ir.ui.view">
        <field name="name">salon.appointment.form</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <form>
                <field name="general_notes_warning" invisible="1"/>
                <field name="pos_order_state" invisible="1"/>
                <field name="general_notes_text" invisible="1"/>
                <header>
                    <button name="action_send_to_pos" type="object" string="Send to POS" class="btn-primary" invisible="(pos_order_id and pos_order_state not in ('draft', 'cancel')) or payment_state == 'paid' or state not in ('progress', 'done')" groups="salon_spa_scheduler.group_salon_create_payment"/>
                    <button name="%(salon_spa_scheduler.action_report_salon_appointment_single)d" type="action" string="Print Details" class="btn-secondary" invisible="state == 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_progress" type="object" string="Start Service" invisible="state != 'confirmed'"/>
                    <field name="can_add_service" invisible="1"/>
                    <button name="action_open_add_service" type="object" string="Add Service" class="btn-secondary" icon="fa-plus" invisible="not can_add_service" groups="salon_spa_scheduler.group_salon_create_appointment"/>
                    <button name="action_done" type="object" string="Done" class="btn-primary" invisible="state != 'progress' or (payment_state != 'paid' and not allow_done_without_payment)"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancel')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'confirmed'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'cancel' or not allow_reset_cancelled" groups="salon_spa_scheduler.group_salon_manager"/>
                    <button name="action_rebook" type="object" string="Rebook" class="btn-secondary" invisible="state not in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,progress,done"/>
                    <field name="allow_done_without_payment" invisible="1"/>
                    <field name="allow_reset_cancelled" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="phone" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="branch_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="room_id" readonly="state != 'draft'"/>
                            <field name="is_walkin" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="staff_service_ids" invisible="1"/>
                            <field name="staff_ids" widget="many2many_tags" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="staff_multi" invisible="1"/>
                            <field name="staff_id" readonly="1" invisible="not staff_multi"/>
                            <field name="service_ids" widget="many2many_tags" readonly="state != 'draft'" domain="[('id', 'in', staff_service_ids)]"/>
                            <field name="start_datetime" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="end_datetime" invisible="1"/>
                            <field name="duration_selection" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="duration" readonly="1"/>
                            <field name="payment_state"/>
                            <field name="pos_order_id"/>
                            <field name="amount_subtotal" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Beauticians &amp; Services" name="service_steps">
                            <field name="can_edit_steps" invisible="1"/>
                            <!-- Until the start; after it only with "Edit Bookings After Start" (manager, unpaid). -->
                            <field name="step_ids" readonly="not can_edit_steps">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="allowed_service_ids" column_invisible="1"/>
                                    <field name="staff_id" optional="show"/>
                                    <field name="staff_required" optional="show"/>
                                    <field name="service_id" domain="[('id', 'in', allowed_service_ids)]" optional="show"/>
                                    <field name="name" optional="hide"/>
                                    <field name="duration_minutes" optional="hide"/>
                                    <field name="price_unit" sum="Total" optional="hide"/>
                                    <field name="need_staff" optional="hide"/>
                                    <field name="timing_mode" optional="hide"/>
                                    <field name="start_datetime" optional="show"/>
                                    <field name="end_datetime" readonly="1" optional="hide"/>
                                    <field name="note" optional="show" placeholder="Note for this beautician..."/>
                                </list>
                            </field>
                        </page>
                        <page string="General Notes" name="general_notes">
                            <group>
                                <field name="general_allergies" readonly="not partner_id"
                                       placeholder="Allergies, medical conditions..."/>
                                <field name="general_preferences" readonly="not partner_id"
                                       placeholder="Preferences, special requests..."/>
                            </group>
                            <separator string="Comments"/>
                            <field name="partner_comment_ids" readonly="not partner_id">
                                <list editable="top" delete="0">
                                    <field name="date" readonly="id"/>
                                    <field name="user_id" readonly="1" force_save="1"/>
                                    <field name="comment_type" readonly="id"/>
                                    <field name="comment" required="1" readonly="id"
                                           placeholder="e.g. was rude to reception, complained about the colour, left without paying..."/>
                                </list>
                            </field>
                        </page>
                        <page string="Customer History" name="customer_history">
                            <field name="customer_history_ids" readonly="1">
                                <list decoration-success="state == 'Completed'" decoration-info="state == 'Paid'" decoration-danger="state == 'Cancelled'">
                                    <field name="date"/>
                                    <field name="service_name"/>
                                    <field name="staff_name"/>
                                    <field name="state"/>
                                    <field name="notes"/>
                                    <field name="price_unit"/>
                                    <field name="origin"/>
                                </list>
                            </field>
                        </page>
                        <page string="Additional Services">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="allowed_service_ids" column_invisible="1"/>
                                    <field name="service_id" domain="[('id', 'in', allowed_service_ids)]"/>
                                    <field name="staff_id"/>
                                    <field name="price_unit" sum="Subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_salon_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">kanban,calendar,list,form</field>
        <field name="search_view_id" ref="view_salon_appointment_search"/>
        <field name="context">{'search_default_filter_today': 1}</field>
    </record>
</odoo>
