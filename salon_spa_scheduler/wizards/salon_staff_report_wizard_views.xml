<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salon_staff_report_wizard_form" model="ir.ui.view">
        <field name="name">salon.staff.report.wizard.form</field>
        <field name="model">salon.staff.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Employee Performance Report">
                <sheet>
                    <div class="oe_title mb-3">
                        <h2>Employee Performance &amp; Earnings Report</h2>
                        <p class="text-muted">Select date range and employees to generate an advanced performance audit including revenue, commissions, tips, and client review ratings.</p>
                    </div>
                    <group>
                        <group string="Date Range">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Filters">
                            <field name="staff_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Select Employees (All if blank)..."/>
                            <field name="branch_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Filter Branches (Optional)..."/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_print_staff_report" string="Generate Performance Report" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_salon_staff_report_wizard" model="ir.actions.act_window">
        <field name="name">Employee Performance Report</field>
        <field name="res_model">salon.staff.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
