<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salon_appointment_add_service_form" model="ir.ui.view">
        <field name="name">salon.appointment.add.service.form</field>
        <field name="model">salon.appointment.add.service</field>
        <field name="arch" type="xml">
            <form string="Add Service">
                <group>
                    <group>
                        <field name="appointment_id"/>
                        <field name="partner_id"/>
                        <field name="current_end"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="service_id" options="{'no_create': True}"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="price" widget="monetary" readonly="1" invisible="not service_id"/>
                        <field name="staff_id" options="{'no_create': True}"/>
                        <field name="duration_minutes"/>
                        <field name="timing_mode" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_add" type="object" string="Add Service" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
