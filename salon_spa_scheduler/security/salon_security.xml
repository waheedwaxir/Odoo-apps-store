<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category -->
    <record id="module_category_salon_spa_scheduler" model="ir.module.category">
        <field name="name">Salon and Spa</field>
        <field name="description">Access rights for Salon and Spa scheduler</field>
        <field name="sequence">20</field>
    </record>

    <!-- Privilege Category -->
    <record model="res.groups.privilege" id="res_groups_privilege_salon_spa">
        <field name="name">Salon and Spa</field>
        <field name="category_id" ref="module_category_salon_spa_scheduler"/>
    </record>

    <!-- Groups -->
    <record id="group_salon_view" model="res.groups">
        <field name="name">User: View Only</field>
        <field name="privilege_id" ref="res_groups_privilege_salon_spa"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_salon_create_appointment" model="res.groups">
        <field name="name">User: Create Appointments</field>
        <field name="privilege_id" ref="res_groups_privilege_salon_spa"/>
        <field name="implied_ids" eval="[(4, ref('group_salon_view'))]"/>
    </record>

    <record id="group_salon_create_payment" model="res.groups">
        <field name="name">User: Create Payments</field>
        <field name="privilege_id" ref="res_groups_privilege_salon_spa"/>
        <field name="implied_ids" eval="[(4, ref('group_salon_view'))]"/>
    </record>

    <record id="group_salon_manager" model="res.groups">
        <field name="name">Manager (Full Access)</field>
        <field name="privilege_id" ref="res_groups_privilege_salon_spa"/>
        <field name="implied_ids" eval="[(4, ref('group_salon_create_appointment')), (4, ref('group_salon_create_payment'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
