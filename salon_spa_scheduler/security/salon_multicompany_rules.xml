<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Global multi-company record rules. A record with company_id = False is
         considered shared and visible to every company.
         Loaded WITHOUT noupdate so domain fixes propagate on module upgrade. -->

    <record id="salon_room_company_rule" model="ir.rule">
        <field name="name">Salon Chair: multi-company</field>
        <field name="model_id" ref="model_salon_room"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

