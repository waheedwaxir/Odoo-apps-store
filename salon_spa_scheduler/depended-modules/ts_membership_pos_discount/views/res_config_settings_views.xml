<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- POS settings: limit the global Discount button to services -->
    <record id="res_config_settings_view_form_ts_discount" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ts.discount</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_global_discount']" position="after">
                <setting id="pos_ts_discount_services_only"
                         help="Apply the Discount button to services only. Untick it to discount services and products."
                         invisible="not pos_module_pos_discount">
                    <field name="pos_ts_discount_services_only"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
