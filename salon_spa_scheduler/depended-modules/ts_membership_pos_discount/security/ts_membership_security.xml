<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ts_membership_plan_company_rule" model="ir.rule">
        <field name="name">Membership plan: multi-company</field>
        <field name="model_id" ref="model_ts_membership_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="ts_membership_company_rule" model="ir.rule">
        <field name="name">Customer membership: multi-company</field>
        <field name="model_id" ref="model_ts_membership"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
