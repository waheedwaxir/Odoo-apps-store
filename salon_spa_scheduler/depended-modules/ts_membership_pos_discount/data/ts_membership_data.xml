<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Product used for the membership discount line in POS orders -->
        <record id="product_product_membership_discount" model="product.product">
            <field name="name">Membership Discount</field>
            <field name="default_code">TS_MEMBER_DISC</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="available_in_pos">True</field>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
            <field name="description_sale">Discount granted to members</field>
        </record>

        <!-- Expire memberships whose end date has passed -->
        <record id="ir_cron_expire_memberships" model="ir.cron">
            <field name="name">Membership: expire ended memberships</field>
            <field name="model_id" ref="model_ts_membership"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_memberships()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
