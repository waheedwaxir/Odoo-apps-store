<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('navbar-menu')]" position="inside">
            <button class="salon-app-button btn btn-lg btn-light lh-lg" t-on-click="() => this.goToSalonApp()" title="Salon &amp; Spa">
                <span t-if="!ui.isSmall">Salon &amp; Spa</span>
                <i t-else="" class="fa fa-fw fa-scissors" t-att-class="{'fa-lg' : !ui.isSmall}"/>
            </button>
        </xpath>
    </t>
</templates>
