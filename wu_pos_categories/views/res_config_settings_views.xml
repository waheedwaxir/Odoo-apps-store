<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.wu_pos_categories</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_iface_group_by_categ']/ancestor::setting" position="after">
                <setting id="single_line_categories_setting" invisible="is_kiosk_mode" help="Display product categories in a single horizontal line with scroll capability instead of a grid.">
                    <field name="pos_iface_single_line_categories"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
