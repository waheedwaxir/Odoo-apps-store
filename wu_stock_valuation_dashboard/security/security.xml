<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_wu_stock_valuation_dashboard" model="ir.module.category">
        <field name="name">Valuation Dashboard</field>
        <field name="sequence">100</field>
    </record>

    <record id="privilege_wu_stock_valuation_dashboard" model="res.groups.privilege">
        <field name="name">Valuation Dashboard</field>
        <field name="category_id" ref="module_category_wu_stock_valuation_dashboard"/>
    </record>

    <record id="group_wu_stock_valuation_dashboard_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_wu_stock_valuation_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_wu_stock_valuation_dashboard_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_wu_stock_valuation_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_wu_stock_valuation_dashboard_user')), (4, ref('stock.group_stock_manager'))]"/>
    </record>
</odoo>
