<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<t owl="1" t-name="wu_stock_valuation_dashboard.Dashboard">
<div class="stock-dashboard-root d-flex vh-100 w-100 overflow-hidden bg-light"><!-- Sidebar Navigation --><div class="bg-white border-end d-flex flex-column shadow-sm" style="width: 250px; min-width: 250px; z-index: 10;">
<div class="p-4 border-bottom d-flex align-items-center bg-white">
<i class="fa fa-cubes text-primary fa-2x me-3"/>
<h4 class="mb-0 fw-bold text-dark" style="letter-spacing: -0.5px;">Inventory</h4>
</div>
<div class="p-3 flex-grow-1 overflow-auto">
<div class="text-muted text-uppercase fw-bold mb-3 ms-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Menu</div>
<ul class="nav nav-pills flex-column mb-auto gap-2">
<li class="nav-item">
<a class="nav-link rounded-3 py-2 px-3 d-flex align-items-center transition-all" href="#" t-att-style="state.currentTab === 'overview' ? 'font-weight: 500; background-color: #f0f4fa; color: #4361ee;' : 'font-weight: 500; color: #6c757d;'" t-on-click.prevent="() =&gt; this.setTab('overview')">
<div class="d-flex align-items-center justify-content-center me-3 rounded" t-att-style="state.currentTab === 'overview' ? 'width: 32px; height: 32px; background-color: #4361ee; color: white;' : 'width: 32px; height: 32px; background-color: #f8f9fa; color: #adb5bd;'">
<i class="fa fa-home"/>
</div>
                    Overview
                </a>
</li>
<li class="nav-item">
<a class="nav-link rounded-3 py-2 px-3 d-flex align-items-center transition-all" href="#" t-att-style="state.currentTab === 'operations' ? 'font-weight: 500; background-color: #fff5f5; color: #e63946;' : 'font-weight: 500; color: #6c757d;'" t-on-click.prevent="() =&gt; this.setTab('operations')">
<div class="d-flex align-items-center justify-content-center me-3 rounded" t-att-style="state.currentTab === 'operations' ? 'width: 32px; height: 32px; background-color: #e63946; color: white;' : 'width: 32px; height: 32px; background-color: #f8f9fa; color: #adb5bd;'">
<i class="fa fa-exchange"/>
</div>
                    Operations
                </a>
</li>
<li class="nav-item">
<a class="nav-link rounded-3 py-2 px-3 d-flex align-items-center transition-all" href="#" t-att-style="state.currentTab === 'products' ? 'font-weight: 500; background-color: #f0fdf4; color: #2a9d8f;' : 'font-weight: 500; color: #6c757d;'" t-on-click.prevent="() =&gt; this.setTab('products')">
<div class="d-flex align-items-center justify-content-center me-3 rounded" t-att-style="state.currentTab === 'products' ? 'width: 32px; height: 32px; background-color: #2a9d8f; color: white;' : 'width: 32px; height: 32px; background-color: #f8f9fa; color: #adb5bd;'">
<i class="fa fa-box"/>
</div>
                    Products
                </a>
</li>
</ul>
</div>
</div><div class="flex-grow-1 overflow-auto bg-light"><div t-att-class="state.currentTab === 'overview' ? 'd-block' : 'd-none'">
<div class="container-fluid py-4 stock-dashboard">
<!-- Loading State -->
<div class="d-flex justify-content-center align-items-center" style="height: 50vh;" t-if="state.isLoading">
<div class="spinner-border text-primary" role="status">
<span class="visually-hidden">Loading...</span>
</div>
</div>
<!-- Dashboard Content -->
<div class="dashboard-content" t-else="">
<!-- Top Control Bar -->
<div class="card shadow-sm border-0 mb-4 rounded-4">
<div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
<h4 class="mb-0 fw-bold text-dark d-none d-lg-block d-flex align-items-center">
<span class="d-flex align-items-center justify-content-center me-2 text-primary" style="font-size: 1.5rem;">
<i class="fa fa-cubes"/>
</span>
                                Inventory Valuation Dashboard
                            </h4>
<div class="d-flex flex-wrap gap-2 align-items-center justify-content-end flex-grow-1">
<!-- Date Range -->
<div class="d-flex align-items-center gap-2">
<div class="input-group input-group-sm shadow-sm">
<span class="input-group-text bg-white border-end-0"><i class="fa fa-calendar text-muted"/></span>
<select class="form-select border-start-0 text-muted" style="width: 130px; background-color: #f8f9fa;" t-on-change="onDateRangeChange">
<option t-att-selected="state.dateRangeMode === 'all'" value="all">All Time</option>
<option t-att-selected="state.dateRangeMode === 'today'" value="today">Today</option>
<option t-att-selected="state.dateRangeMode === 'this_week'" value="this_week">This Week</option>
<option t-att-selected="state.dateRangeMode === 'this_month'" value="this_month">This Month</option>
<option t-att-selected="state.dateRangeMode === 'last_month'" value="last_month">Last Month</option>
<option t-att-selected="state.dateRangeMode === 'this_year'" value="this_year">This Year</option>
<option t-att-selected="state.dateRangeMode === 'custom'" value="custom">Custom Range</option>
</select>
</div>
<!-- Custom Date Range Inputs -->
<div class="d-flex align-items-center gap-1 shadow-sm rounded-3 bg-white border p-1" style="max-width: 320px;" t-if="state.dateRangeMode === 'custom'">
<DateTimeInput onChange.bind="onDateFromChangeObj" type="'date'" value="dateFromObj"/>
<span class="text-muted fw-bold px-1">-</span>
<DateTimeInput onChange.bind="onDateToChangeObj" type="'date'" value="dateToObj"/>
</div>
</div>
<!-- Companies Filter -->
<select class="form-select form-select-sm shadow-sm border-0 rounded-3 text-muted" style="max-width: 150px; background-color: #f8f9fa;" t-on-change="onCompanyChange">
<option value="">All Companies</option>
<t t-as="company" t-foreach="state.filters.companies" t-key="company.id">
<option t-att-selected="state.selectedCompanyId == company.id" t-att-value="company.id"><t t-esc="company.name"/></option>
</t>
</select>
<!-- Warehouses Filter -->
<select class="form-select form-select-sm shadow-sm border-0 rounded-3 text-muted" style="max-width: 150px; background-color: #f8f9fa;" t-on-change="onWarehouseChange">
<option value="">All Warehouses</option>
<t t-as="warehouse" t-foreach="state.filters.warehouses" t-key="warehouse.id">
<!-- Only show warehouses for selected company -->
<t t-if="!state.selectedCompanyId or warehouse.company_id[0] == state.selectedCompanyId">
<option t-att-selected="state.selectedWarehouseId == warehouse.id" t-att-value="warehouse.id"><t t-esc="warehouse.name"/></option>
</t>
</t>
</select>
<!-- Categories Filter -->
<select class="form-select form-select-sm shadow-sm border-0 rounded-3 text-muted" style="max-width: 150px; background-color: #f8f9fa;" t-on-change="onCategoryChange">
<option value="">All Categories</option>
<t t-as="category" t-foreach="state.filters.categories" t-key="category.id">
<t t-if="!category.company_id or !state.selectedCompanyId or category.company_id[0] == state.selectedCompanyId">
<option t-att-selected="state.selectedCategoryId == category.id" t-att-value="category.id"><t t-esc="category.name"/></option>
</t>
</t>
</select>
<button class="btn btn-sm btn-primary rounded-3 px-3 shadow-sm ms-1" t-on-click="refreshDashboard">
<i class="fa fa-refresh me-1"/> Refresh
                                </button>
</div>
</div>
</div>
<!-- KPI Cards (6 Items) -->
<div class="row g-3 mb-4 kpi-row">
<!-- Total Inventory Value -->
<div class="col-6 col-md-4 col-xl-3">
<div class="card stat-card-pastel shadow-sm border-0 h-100 rounded-4 cursor-pointer" style="background: linear-gradient(135deg, #8e86ff, #685cf0); color: white;" t-on-click="() =&gt; this.openInventory('valuation')">
<div class="card-body d-flex flex-column justify-content-between p-3">
<div class="d-flex justify-content-between align-items-start">
<div class="icon-box rounded-3 bg-white bg-opacity-25 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
<i class="fa fa-money fa-lg text-white"/>
</div>
<div class="text-end">
<h6 class="text-white-75 mb-1" style="font-size: 0.85rem; font-weight: 500;">Total Inventory Value</h6>
<h3 class="mb-0 fw-bold" style="font-size: 1.7rem;"><t t-esc="state.data.currency_symbol"/> <t t-esc="state.data.total_value.toLocaleString()"/></h3>
</div>
</div>
<div class="mt-2" style="font-size: 0.75rem;">
<t t-set="pct" t-value="getPercentChange(state.data.total_value, state.data.prev_total_value)"/>
<t t-if="pct &gt; 0">
<span class="text-white fw-bold"><i class="fa fa-arrow-up" style="transform: rotate(45deg); display: inline-block;"/> +<t t-esc="pct"/>%</span> <span class="text-white-50">vs prev</span>
</t>
<t t-elif="pct &lt; 0">
<span class="text-white-75 fw-bold"><i class="fa fa-arrow-down" style="transform: rotate(45deg); display: inline-block;"/> <t t-esc="pct"/>%</span> <span class="text-white-50">vs prev</span>
</t>
<t t-else="">
<span class="text-white-50"><i class="fa fa-minus"/> 0%</span> <span class="text-white-50">vs prev</span>
</t>
</div>
</div>
</div>
</div>
<!-- Total Stock Quantity -->
<div class="col-6 col-md-4 col-xl-3">
<div class="card stat-card-pastel shadow-sm border-0 h-100 rounded-4 cursor-pointer" style="background: linear-gradient(135deg, #2bbaff, #009cf0); color: white;" t-on-click="() =&gt; this.openInventory('quantity')">
<div class="card-body d-flex flex-column justify-content-between p-3">
<div class="d-flex justify-content-between align-items-start">
<div class="icon-box rounded-3 bg-white bg-opacity-25 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
<i class="fa fa-cubes fa-lg text-white"/>
</div>
<div class="text-end">
<h6 class="text-white-75 mb-1" style="font-size: 0.85rem; font-weight: 500;">On Hand Quantity</h6>
<h3 class="mb-0 fw-bold" style="font-size: 1.7rem;"><t t-esc="state.data.total_qty.toLocaleString()"/></h3>
</div>
</div>
<div class="mt-2" style="font-size: 0.75rem;">
<t t-set="pct" t-value="getPercentChange(state.data.total_qty, state.data.prev_total_qty)"/>
<t t-if="pct &gt; 0">
<span class="text-white fw-bold"><i class="fa fa-arrow-up" style="transform: rotate(45deg); display: inline-block;"/> +<t t-esc="pct"/>%</span> <span class="text-white-50">vs prev</span>
</t>
<t t-elif="pct &lt; 0">
<span class="text-white-75 fw-bold"><i class="fa fa-arrow-down" style="transform: rotate(45deg); display: inline-block;"/> <t t-esc="pct"/>%</span> <span class="text-white-50">vs prev</span>
</t>
<t t-else="">
<span class="text-white-50"><i class="fa fa-minus"/> 0%</span> <span class="text-white-50">vs prev</span>
</t>
</div>
</div>
</div>
</div><!-- Reserved Quantity --><div class="col-6 col-md-4 col-xl-3">
<div class="card stat-card-pastel shadow-sm border-0 h-100 rounded-4 cursor-pointer" style="background: linear-gradient(135deg, #ffc107, #ff9800); color: white;" t-on-click="() =&gt; this.openInventory('reserved')">
<div class="card-body p-3 p-xl-4 d-flex flex-column justify-content-between">
<div class="d-flex justify-content-between align-items-start mb-2">
<div>
<p class="text-white-75 mb-1 fw-medium" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Reserved Qty</p>
<h3 class="fw-bold mb-0 text-white"><t t-esc="state.data.total_reserved_qty"/></h3>
</div>
<div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background-color: rgba(255, 255, 255, 0.2);">
<i class="fa fa-lock fa-lg text-white"/>
</div>
</div>
</div>
</div>
</div><!-- Available Quantity --><div class="col-6 col-md-4 col-xl-3">
<div class="card stat-card-pastel shadow-sm border-0 h-100 rounded-4 cursor-pointer" style="background: linear-gradient(135deg, #28a745, #20c997); color: white;" t-on-click="() =&gt; this.openInventory('available')">
<div class="card-body p-3 p-xl-4 d-flex flex-column justify-content-between">
<div class="d-flex justify-content-between align-items-start mb-2">
<div>
<p class="text-white-75 mb-1 fw-medium" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Available Qty</p>
<h3 class="fw-bold mb-0 text-white"><t t-esc="state.data.total_available_qty"/></h3>
</div>
<div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background-color: rgba(255, 255, 255, 0.2);">
<i class="fa fa-check-circle fa-lg text-white"/>
</div>
</div>
</div>
</div>
</div>












</div>
<!-- Financial Valuation Summary -->
<div class="row g-3 mb-4">
<div class="col-12">
<div class="card shadow-sm border-0 rounded-4">
<div class="card-header bg-white border-0 py-3 rounded-top-4 border-bottom">
<h6 class="mb-0 fw-bold"><i class="fa fa-calculator text-primary me-2"/> Financial Valuation &amp; Stock Summary</h6>
</div>
<div class="card-body p-3">
<div class="row text-center g-3">
<div class="col-6 col-md-4 col-xl border-end">
<div class="text-muted mb-1" style="font-size: 0.75rem; text-transform: uppercase;">Beginning Balance</div>
<div class="fw-bold fs-5"><t t-esc="state.data.currency_symbol"/> <t t-esc="state.data.beginning_balance.toLocaleString()"/></div>
</div>
<div class="col-6 col-md-4 col-xl border-end">
<div class="text-muted mb-1" style="font-size: 0.75rem; text-transform: uppercase;">Ending Balance</div>
<div class="fw-bold fs-5 text-primary"><t t-esc="state.data.currency_symbol"/> <t t-esc="state.data.ending_balance.toLocaleString()"/></div>
</div>
<div class="col-6 col-md-4 col-xl border-end">
<div class="text-muted mb-1" style="font-size: 0.75rem; text-transform: uppercase;">Internal Balance</div>
<div class="fw-bold fs-5"><t t-esc="state.data.currency_symbol"/> <t t-esc="state.data.internal_balance.toLocaleString()"/></div>
</div>
<div class="col-6 col-md-4 col-xl border-end">
<div class="text-muted mb-1" style="font-size: 0.75rem; text-transform: uppercase;">Inventory Adjustments</div>
<div class="fw-bold fs-5 text-warning"><t t-esc="state.data.currency_symbol"/> <t t-esc="state.data.inventory_adjustments.toLocaleString()"/></div>
</div>
<div class="col-6 col-md-4 col-xl border-end">
<div class="text-muted mb-1" style="font-size: 0.75rem; text-transform: uppercase;">Exact COGS</div>
<div class="fw-bold fs-5 text-danger"><t t-esc="state.data.currency_symbol"/> <t t-esc="state.data.exact_cogs.toLocaleString()"/></div>
</div>
<div class="col-6 col-md-4 col-xl border-end">
<div class="text-muted mb-1" style="font-size: 0.75rem; text-transform: uppercase;">Sales Revenue</div>
<div class="fw-bold fs-5 text-success"><t t-esc="state.data.currency_symbol"/> <t t-esc="state.data.total_sales_value.toLocaleString()"/></div>
</div>
<div class="col-6 col-md-4 col-xl">
<div class="text-muted mb-1" style="font-size: 0.75rem; text-transform: uppercase;">Gross Profit</div>
<div class="fw-bold fs-5 text-success"><t t-esc="state.data.currency_symbol"/> <t t-esc="state.data.gross_profit.toLocaleString()"/></div>
</div>
</div>
</div>
</div>
</div>
</div>
<!-- Financial Performance Summary Row -->
<div class="row g-3 mb-4">
<div class="col-12 mb-1">
<h5 class="fw-bold text-muted mb-0"><i class="fa fa-line-chart me-2"/>Financial Summary</h5>
</div>
<div class="col-6 col-md-3">
<div class="card shadow-sm border-0 h-100 rounded-4 cursor-pointer bg-white" t-on-click="() =&gt; this.openInventory('valuation')">
<div class="card-body p-3">
<div class="text-muted fw-bold mb-1" style="font-size: 0.85rem; font-weight: 500;">Beginning Balance</div>
<h5 class="mb-0 text-dark fw-bold"><t t-esc="state.data.currency_symbol"/> <t t-esc="state.data.beginning_balance.toLocaleString()"/></h5>
</div>
</div>
</div>
<div class="col-6 col-md-3">
<div class="card shadow-sm border-0 h-100 rounded-4 cursor-pointer bg-white" t-on-click="() =&gt; this.openInventory('adjustments')">
<div class="card-body p-3">
<div class="text-muted fw-bold mb-1" style="font-size: 0.85rem; font-weight: 500;">Inventory Adjustments</div>
<h5 class="mb-0 text-info fw-bold"><t t-esc="state.data.currency_symbol"/> <t t-esc="state.data.inventory_adjustments.toLocaleString()"/></h5>
</div>
</div>
</div>
<div class="col-6 col-md-3">
<div class="card shadow-sm border-0 h-100 rounded-4 cursor-pointer bg-white" t-on-click="() =&gt; this.openInventory('cogs')">
<div class="card-body p-3">
<div class="text-muted fw-bold mb-1" style="font-size: 0.85rem; font-weight: 500;">Exact COGS (Shipped)</div>
<h5 class="mb-0 text-danger fw-bold"><t t-esc="state.data.currency_symbol"/> <t t-esc="state.data.exact_cogs.toLocaleString()"/></h5>
</div>
</div>
</div>
<div class="col-6 col-md-3">
<div class="card shadow-sm border-0 h-100 rounded-4 bg-white" title="Potential revenue from current stock minus historical COGS">
<div class="card-body p-3">
<div class="text-muted fw-bold mb-1" style="font-size: 0.85rem; font-weight: 500;">Gross Profit (Est)</div>
<h5 class="mb-0 text-success fw-bold"><t t-esc="state.data.currency_symbol"/> <t t-esc="state.data.gross_profit.toLocaleString()"/></h5>
</div>
</div>
</div>
</div>
<!-- Charts Row 1 -->
<div class="row g-4 mb-4">
<!-- Value by Category -->
<div class="col-12 col-xl-4">
<div class="card shadow-sm border-0 rounded-4 h-100">
<div class="card-header bg-white border-0 py-3 rounded-top-4 d-flex justify-content-between align-items-center">
<h6 class="mb-0 fw-bold">Stock Value by Product Category</h6>
<select class="form-select form-select-sm border-0 text-muted shadow-sm" style="width: 90px; background-color: #f8f9fa;">
<option>Value</option>
</select>
</div>
<div class="card-body pb-4" style="position: relative; height: 260px;">
<canvas t-ref="categoryChart"/>
</div>
</div>
</div>
<!-- Value by Warehouse -->
<div class="col-12 col-xl-4">
<div class="card shadow-sm border-0 rounded-4 h-100">
<div class="card-header bg-white border-0 py-3 rounded-top-4 d-flex justify-content-between align-items-center">
<h6 class="mb-0 fw-bold">Stock Value by Warehouse</h6>
<select class="form-select form-select-sm border-0 text-muted shadow-sm" style="width: 90px; background-color: #f8f9fa;">
<option>Value</option>
</select>
</div>
<div class="card-body pb-4" style="position: relative; height: 260px;">
<canvas t-ref="warehouseChart"/>
</div>
</div>
</div>
<!-- Incoming & Outgoing -->
<div class="col-12 col-xl-4">
<div class="card shadow-sm border-0 rounded-4 h-100">
<div class="card-header bg-white border-0 py-3 rounded-top-4 d-flex justify-content-between align-items-center">
<h6 class="mb-0 fw-bold">Incoming &amp; Outgoing Stock</h6>
<select class="form-select form-select-sm border-0 text-muted shadow-sm" style="width: 80px; background-color: #f8f9fa;">
<option>Qty</option>
</select>
</div>
<div class="card-body pb-4" style="position: relative; height: 260px;">
<canvas t-ref="movementChart"/>
</div>
</div>
</div>
</div>
<!-- Charts Row 2 -->
<div class="row g-4 mb-4">


<!-- Cost vs Sales -->
<div class="col-12 col-xl-3">
<div class="card shadow-sm border-0 rounded-4 h-100">
<div class="card-header bg-white border-0 py-3 rounded-top-4 d-flex justify-content-between align-items-center">
<h6 class="mb-0 fw-bold">Cost vs. Sales Value</h6>
<i class="fa fa-ellipsis-v text-muted cursor-pointer"/>
</div>
<div class="card-body pb-4" style="position: relative; height: 260px;">
<canvas t-ref="costSalesChart"/>
</div>
</div>
</div>
<!-- Notifications & Alerts -->
<div class="col-12 col-xl-3">
<div class="card shadow-sm border-0 rounded-4 h-100">
<div class="card-header bg-white border-0 py-3 rounded-top-4 d-flex justify-content-between align-items-center border-bottom">
<h6 class="mb-0 fw-bold">Stock Alerts &amp; Notifications</h6>
<a class="text-primary text-decoration-none" href="#" style="font-size: 0.85rem;" t-on-click.prevent="() =&gt; this.openInventory('low_stock')">View All</a>
</div>
<div class="card-body p-0 overflow-auto" style="max-height: 280px;">
<t t-if="state.data.notifications.length">
<ul class="list-group list-group-flush">
<t t-as="notif" t-foreach="state.data.notifications" t-key="notif.title">
<li class="list-group-item d-flex justify-content-between align-items-center p-3 border-0 border-bottom">
<div class="d-flex align-items-center gap-3">
<div style="width: 36px; height: 36px;" t-attf-class="icon-box rounded-3 bg-{{notif.type}} bg-opacity-10 text-{{notif.type}} d-flex align-items-center justify-content-center">
<i t-attf-class="fa {{notif.icon}}"/>
</div>
<div>
<div class="fw-bold" style="font-size: 0.85rem;"><t t-esc="notif.title"/></div>
<div class="text-muted" style="font-size: 0.75rem;"><t t-esc="notif.desc"/></div>
</div>
</div>
<span t-attf-class="fw-bold text-{{notif.type}}"><t t-esc="notif.value"/></span>
</li>
</t>
</ul>
</t>
<t t-else="">
<div class="p-4 text-center text-muted">
<i class="fa fa-check-circle fa-2x mb-2 text-success"/>
<p class="mb-0" style="font-size: 0.85rem;">All stock levels look healthy!</p>
</div>
</t>
</div>
</div>
</div>
</div>
<!-- Charts Row 3 -->
<div class="row g-4 mb-4">
<!-- Daily/Monthly Trend -->
<div class="col-12 col-xl-4">
<div class="card shadow-sm border-0 rounded-4 h-100">
<div class="card-header bg-white border-0 py-3 pb-0 rounded-top-4">
<div class="d-flex justify-content-between align-items-center mb-3">
<h6 class="mb-0 fw-bold">Daily / Monthly / Yearly Valuation</h6>
</div>
<div class="d-flex rounded-3 p-1 w-100 mb-3" style="background-color: #f3f4f6;">
