<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="res_groups_privilege_dashboard" model="res.groups.privilege">
            <field name="name">Employee 360 Dashboard</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
        </record>

        <record id="group_hr_dashboard_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="wu_hr_employee360.res_groups_privilege_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">User access for the Employee 360 Dashboard.</field>
        </record>

        <record id="group_hr_dashboard_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="wu_hr_employee360.res_groups_privilege_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('wu_hr_employee360.group_hr_dashboard_user'))]"/>
            <field name="comment">Manager access for the Employee 360 Dashboard.</field>
        </record>

    </data>
</odoo>
