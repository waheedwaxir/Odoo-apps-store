<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Daily Smart Alert Digest Cron — runs every day at 08:00 -->
        <record id="ir_cron_hr360_daily_digest" model="ir.cron">
            <field name="name">HR 360 — Daily Smart Alert Digest Email</field>
            <field name="model_id" ref="wu_hr_employee360.model_hr_smart_alert"/>
            <field name="state">code</field>
            <field name="code">model.send_daily_digest()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.datetime.now() + datetime.timedelta(days=1)).replace(hour=8, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Weekly Smart Alert Regeneration — runs every Sunday at 07:00 -->
        <record id="ir_cron_hr360_regen_alerts" model="ir.cron">
            <field name="name">HR 360 — Weekly Smart Alert Regeneration</field>
            <field name="model_id" ref="wu_hr_employee360.model_hr_smart_alert"/>
            <field name="state">code</field>
            <field name="code">model.generate_smart_alerts()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.datetime.now() + datetime.timedelta(days=1)).replace(hour=7, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
