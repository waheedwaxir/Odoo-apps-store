<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ─────────────────────────────────────────────────────────── -->
        <!-- MAIL TEMPLATE 1: Daily Smart Alert Digest (HR Manager)      -->
        <!-- ─────────────────────────────────────────────────────────── -->
        <record id="email_template_hr360_daily_digest" model="mail.template">
            <field name="name">HR 360 — Daily Smart Alert Digest</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">📊 HR 360 Daily Alert Digest — {{ object.company_id.name or 'Your Organisation' }} | {{ (datetime.date.today()).strftime('%d %b %Y') }}</field>
            <field name="email_from">{{ (user.email_formatted or user.company_id.email or 'hr@company.com') }}</field>
            <field name="email_to">{{ ctx.get('recipient_email', '') }}</field>
            <field name="lang">{{ ctx.get('lang') }}</field>
            <field name="body_html" type="html">
<div style="margin:0;padding:0;background:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="max-width:680px;margin:0 auto;">
    <!-- Header -->
    <tr>
      <td style="background:linear-gradient(135deg,#1e293b 0%,#334155 100%);padding:32px 40px;border-radius:12px 12px 0 0;">
        <table width="100%" cellpadding="0" cellspacing="0">
          <tr>
            <td>
              <div style="font-size:24px;font-weight:800;color:#fff;letter-spacing:-0.5px;">
                🏢 HR Employee 360°
              </div>
              <div style="font-size:13px;color:#94a3b8;margin-top:4px;">Daily Smart Alert Digest</div>
            </td>
            <td style="text-align:right;">
              <div style="background:#3b82f6;color:#fff;padding:8px 18px;border-radius:999px;font-size:12px;font-weight:700;display:inline-block;">
                {{ ctx.get('today_date','') }}
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- Summary Row -->
    <tr>
      <td style="background:#fff;padding:24px 40px;">
        <table width="100%" cellpadding="0" cellspacing="0">
          <tr>
            <td style="padding:4px;">
              <div style="background:#fff5f5;border:1px solid #fecaca;border-radius:10px;padding:16px 20px;text-align:center;">
                <div style="font-size:28px;font-weight:900;color:#ef4444;">{{ ctx.get('critical_count',0) }}</div>
                <div style="font-size:11px;color:#ef4444;font-weight:700;text-transform:uppercase;margin-top:2px;">🔴 Critical</div>
              </div>
            </td>
            <td style="padding:4px;">
              <div style="background:#fffbf0;border:1px solid #fde68a;border-radius:10px;padding:16px 20px;text-align:center;">
                <div style="font-size:28px;font-weight:900;color:#d97706;">{{ ctx.get('warning_count',0) }}</div>
                <div style="font-size:11px;color:#d97706;font-weight:700;text-transform:uppercase;margin-top:2px;">🟡 Warning</div>
              </div>
            </td>
            <td style="padding:4px;">
              <div style="background:#f0f7ff;border:1px solid #bfdbfe;border-radius:10px;padding:16px 20px;text-align:center;">
                <div style="font-size:28px;font-weight:900;color:#3b82f6;">{{ ctx.get('info_count',0) }}</div>
                <div style="font-size:11px;color:#3b82f6;font-weight:700;text-transform:uppercase;margin-top:2px;">🔵 Info</div>
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- Critical Alerts Section -->
    <tr t-if="ctx.get('critical_alerts')">
      <td style="background:#fff;padding:0 40px 24px;">
        <div style="font-weight:700;font-size:14px;color:#1e293b;border-bottom:2px solid #fecaca;padding-bottom:8px;margin-bottom:12px;">
          🔴 Critical Alerts — Immediate Action Required
        </div>
        <table width="100%" cellpadding="0" cellspacing="0">
          {% for alert in ctx.get('critical_alerts',[]) %}
          <tr>
            <td style="padding:8px 12px;background:#fff5f5;border-left:4px solid #ef4444;border-radius:0 6px 6px 0;margin-bottom:8px;display:block;">
              <div style="font-weight:600;color:#1e293b;font-size:13px;">{{ alert.get('message','') }}</div>
              <div style="color:#64748b;font-size:11px;margin-top:2px;">
                {{ alert.get('employee_name','') }}
                {% if alert.get('department') %} · {{ alert.get('department','') }}{% endif %}
                · Due: {{ alert.get('due_date','') }}
              </div>
            </td>
          </tr>
          <tr><td style="height:6px;"></td></tr>
          {% endfor %}
        </table>
      </td>
    </tr>

    <!-- Warning Alerts Section -->
    <tr t-if="ctx.get('warning_alerts')">
      <td style="background:#fff;padding:0 40px 24px;">
        <div style="font-weight:700;font-size:14px;color:#1e293b;border-bottom:2px solid #fde68a;padding-bottom:8px;margin-bottom:12px;">
          🟡 Warning Alerts
        </div>
        <table width="100%" cellpadding="0" cellspacing="0">
          {% for alert in ctx.get('warning_alerts',[]) %}
          <tr>
            <td style="padding:8px 12px;background:#fffbf0;border-left:4px solid #f59e0b;border-radius:0 6px 6px 0;">
              <div style="font-weight:600;color:#1e293b;font-size:13px;">{{ alert.get('message','') }}</div>
              <div style="color:#64748b;font-size:11px;margin-top:2px;">
                {{ alert.get('employee_name','') }} · Due: {{ alert.get('due_date','') }}
              </div>
            </td>
          </tr>
          <tr><td style="height:6px;"></td></tr>
          {% endfor %}
        </table>
      </td>
    </tr>

    <!-- CTA Button -->
    <tr>
      <td style="background:#fff;padding:0 40px 32px;text-align:center;">
        <a href="{{ ctx.get('dashboard_url','#') }}"
           style="background:linear-gradient(135deg,#3b82f6,#6366f1);color:#fff;padding:14px 32px;border-radius:10px;font-weight:700;font-size:14px;text-decoration:none;display:inline-block;">
          Open HR 360 Dashboard →
        </a>
      </td>
    </tr>

    <!-- Footer -->
    <tr>
      <td style="background:#f1f5f9;padding:20px 40px;border-radius:0 0 12px 12px;text-align:center;">
        <div style="font-size:11px;color:#94a3b8;">
          HR Employee 360° Dashboard Pro · {{ object.company_id.name or '' }} · Auto-generated digest
        </div>
      </td>
    </tr>
  </table>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- ─────────────────────────────────────────────────────────── -->
        <!-- MAIL TEMPLATE 2: Instant Critical Alert (per-alert)         -->
        <!-- ─────────────────────────────────────────────────────────── -->
        <record id="email_template_hr360_critical_instant" model="mail.template">
            <field name="name">HR 360 — Instant Critical Alert</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">🚨 Critical HR Alert: {{ ctx.get('alert_message','Action Required') }}</field>
            <field name="email_from">{{ (user.email_formatted or user.company_id.email or 'hr@company.com') }}</field>
            <field name="email_to">{{ ctx.get('recipient_email','') }}</field>
            <field name="body_html" type="html">
<div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;max-width:600px;margin:0 auto;background:#fff;">
  <div style="background:linear-gradient(135deg,#ef4444,#b91c1c);padding:28px 32px;border-radius:12px 12px 0 0;">
    <div style="font-size:22px;font-weight:800;color:#fff;">🚨 Critical HR Alert</div>
    <div style="color:#fecaca;font-size:13px;margin-top:4px;">Immediate action required</div>
  </div>
  <div style="padding:28px 32px;background:#fff5f5;border:1px solid #fecaca;">
    <div style="font-size:16px;font-weight:700;color:#1e293b;margin-bottom:12px;">{{ ctx.get('alert_message','') }}</div>
    <table cellpadding="0" cellspacing="0" style="width:100%;">
      <tr>
        <td style="padding:6px 0;color:#64748b;font-size:13px;width:130px;">Employee:</td>
        <td style="padding:6px 0;font-weight:600;color:#1e293b;font-size:13px;">{{ ctx.get('employee_name','N/A') }}</td>
      </tr>
      <tr>
        <td style="padding:6px 0;color:#64748b;font-size:13px;">Department:</td>
        <td style="padding:6px 0;font-weight:600;color:#1e293b;font-size:13px;">{{ ctx.get('department','N/A') }}</td>
      </tr>
      <tr>
        <td style="padding:6px 0;color:#64748b;font-size:13px;">Due Date:</td>
        <td style="padding:6px 0;font-weight:600;color:#ef4444;font-size:13px;">{{ ctx.get('due_date','N/A') }}</td>
      </tr>
      <tr>
        <td style="padding:6px 0;color:#64748b;font-size:13px;">Alert Type:</td>
        <td style="padding:6px 0;font-weight:600;color:#1e293b;font-size:13px;">{{ ctx.get('alert_type','') }}</td>
      </tr>
    </table>
  </div>
  <div style="padding:24px 32px;text-align:center;background:#fff;">
    <a href="{{ ctx.get('dashboard_url','#') }}"
       style="background:#ef4444;color:#fff;padding:12px 28px;border-radius:8px;font-weight:700;font-size:13px;text-decoration:none;">
      View in Dashboard →
    </a>
  </div>
  <div style="padding:16px 32px;background:#f8fafc;border-radius:0 0 12px 12px;text-align:center;">
    <div style="font-size:11px;color:#94a3b8;">HR 360° Dashboard Pro · Auto-generated alert</div>
  </div>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
