<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Form View Inheritance -->
    <record id="view_employee_form_inherit_dashboard_360_pro" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.dashboard.360.pro</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Add Smart Button inside div name="button_box" -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_360_profile"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-dashboard"
                        help="Open complete interactive 13-Facet Employee 360° Profile Drawer">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">360°</span>
                        <span class="o_stat_text">Profile</span>
                    </div>
                </button>
            </xpath>

            <!-- Add Probation End Date field after contract_type_id -->
            <xpath expr="//field[@name='contract_type_id']" position="after">
                <field name="trial_date_end"
                       string="Probation End Date"
                       groups="hr.group_hr_manager"
                       widget="date"
                       optional="show"/>
            </xpath>

            <!-- Add Blood Group and Religion to Personal Info tab under Emergency Contact -->
            <xpath expr="//field[@name='emergency_phone']" position="after">
                <field name="blood_group" optional="show"/>
                <field name="religion" optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>
