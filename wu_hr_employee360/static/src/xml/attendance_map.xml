<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wu_hr_employee360.AttendanceMap" owl="1">
        <div class="attendance-map-container card border-0 shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                <div>
                    <h6 class="fw-bold m-0 text-dark"><i class="fa fa-map-marker text-danger me-1"/> Live GPS Geofencing &amp; Check-In Radar</h6>
                    <span class="fs-8 text-muted">Real-time mobile field employee check-ins vs. branch geofence boundary (Radius: 500m)</span>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-success d-flex align-items-center gap-1"><i class="fa fa-circle fs-9"/> Within Geofence</span>
                    <span class="badge bg-danger d-flex align-items-center gap-1"><i class="fa fa-exclamation-circle fs-9"/> Out of Bounds Breach</span>
                </div>
            </div>
            <div t-ref="mapContainer" style="height: 380px; width: 100%; border-radius: 12px; overflow: hidden; background: #e2e8f0;" class="position-relative d-flex align-items-center justify-content-center">
                <!-- Fallback or interactive points overlay before Leaflet fully attaches -->
                <div class="text-center text-muted p-4">
                    <i class="fa fa-map-o fa-3x mb-2 text-secondary"/>
                    <p class="m-0 fw-bold">Interactive Geofence Radar</p>
                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-3">
                        <div t-foreach="props.points" t-as="pt" t-key="pt.name"
                             t-attf-class="badge p-2 {{ pt.is_breach ? 'bg-danger text-white' : (pt.type === 'branch' ? 'bg-primary text-white' : 'bg-success text-white') }}">
                            <i t-attf-class="fa {{ pt.type === 'branch' ? 'fa-building' : (pt.is_breach ? 'fa-warning' : 'fa-user') }} me-1"/>
                            <t t-esc="pt.name"/> <t t-if="pt.time">(<t t-esc="pt.time"/>)</t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
